# Environment variables for VocabQuest deployment.
# Copy this file to .env (locally) or set these in your deploy platform's dashboard.
# NEVER commit your real .env — it's already in .gitignore.

# 1. Database — REQUIRED.
#    LOCAL DEV (SQLite): file:./db/custom.db
#    PRODUCTION (recommended): use a hosted Postgres URL from Neon / Supabase / Railway.
#    If you switch to Postgres, also change the provider in prisma/schema.prisma from "sqlite" to "postgresql"
#    and run `bun run db:push`.
DATABASE_URL=file:./db/custom.db

# 2. NextAuth secret — REQUIRED. Generate with: openssl rand -base64 32
#    Used to sign session JWTs. Must be the same across restarts (or sessions invalidate).
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# 3. Encryption key — REQUIRED. Generate with: openssl rand -hex 32
#    64-char hex string (32 bytes). Used to encrypt user-provided AI API keys at rest.
#    Must be the same across restarts (or stored keys become undecryptable).
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
